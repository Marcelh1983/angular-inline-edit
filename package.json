{
  "name": "angular-inline-edit",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for the ngx-edit-inline Angular library and its demo application.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marcelh1983/angular-inline-edit.git"
  },
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build ngx-edit-inline",
    "build:demo": "ng build demo",
    "watch": "ng build ngx-edit-inline --watch --configuration development",
    "test": "ng test ngx-edit-inline",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "npm run build && cp README.md changelog.md dist/ngx-edit-inline/ && npm publish ./dist/ngx-edit-inline"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.12"
  }
}
